<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Frosted Glass Capsule Background -->
    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <!-- Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- Left Mini Dial -->
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp">

            <ImageView
                android:id="@+id/widget_mini_dial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/widget_mini_bolt"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_launcher_foreground"
                android:tint="#00E676"
                android:contentDescription="@null" />
        </FrameLayout>

        <!-- Middle Percentage -->
        <TextView
            android:id="@+id/widget_battery_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="--%"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#111111"
            android:includeFontPadding="false" />

        <!-- Spacer Divider (ImageView, not View!) -->
        <ImageView
            android:layout_width="1dp"
            android:layout_height="18dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:background="#33888888"
            android:contentDescription="@null" />

        <!-- Right Power & Temperature Status -->
        <TextView
            android:id="@+id/widget_power_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Discharging • --°C"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#555555"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

</FrameLayout>
