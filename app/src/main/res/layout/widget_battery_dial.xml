<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Frosted Glass Background -->
    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <!-- Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="12dp">

        <!-- Top Header -->
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="VOLTAR BATTERY"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#8E8E93"
            android:letterSpacing="0.08"
            android:includeFontPadding="false" />

        <!-- Donut Ring with Percentage in Center -->
        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp">

            <ImageView
                android:id="@+id/widget_gauge_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="Battery Gauge" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/widget_charging_icon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_launcher_foreground"
                    android:tint="#00E676"
                    android:contentDescription="Charging"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/widget_battery_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--%"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#111111"
                    android:includeFontPadding="false" />
            </LinearLayout>
        </FrameLayout>

        <!-- Bottom Subtitle / Live State -->
        <TextView
            android:id="@+id/widget_charging_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Discharging • --°C"
            android:textSize="11sp"
            android:textColor="#555555"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

</FrameLayout>
