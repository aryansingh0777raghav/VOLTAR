<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Frosted Glass Background -->
    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <!-- Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <!-- Left Column: Power & State -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VOLTAR CHARGING LAB"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#8E8E93"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/widget_power_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Not Charging"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#111111"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/widget_charging_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Discharging"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#00E676" />
        </LinearLayout>

        <!-- Right Column: 3 Metric Pills -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <!-- Metric 1: Current -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <ImageView
                    android:layout_width="4dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/widget_pill_emerald"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/widget_current_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 mA"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#333333" />
            </LinearLayout>

            <!-- Metric 2: Voltage -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <ImageView
                    android:layout_width="4dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/widget_pill_emerald"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/widget_voltage_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.00 V"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#333333" />
            </LinearLayout>

            <!-- Metric 3: Temp -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="4dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/widget_pill_emerald"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/widget_temp_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="32°C (Normal)"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#333333" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
